# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smb_financial_management

# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=True
APP_NAME=SMB Financial Management System
APP_VERSION=1.0.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# OCR
OCR_LANGUAGE=eng+spa
